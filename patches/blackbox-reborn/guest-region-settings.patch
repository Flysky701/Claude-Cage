+package top.niunaijun.blackbox.region;
+
+import android.content.Context;
+import android.content.res.Configuration;
+import android.content.res.Resources;
+import android.os.LocaleList;
+import android.util.AtomicFile;
+import android.util.Log;
+import java.io.*;
+import java.util.*;
+
+public final class GuestRegion {
+    public final String language, zone;
+    private static GuestRegion bound;
+
+    public GuestRegion(String language, String zone) {
+        Locale locale;
+        try {
+            locale = new Locale.Builder().setLanguageTag(language.trim()).build();
+        } catch (IllformedLocaleException ex) {
+            throw new IllegalArgumentException("请输入有效的语言标签", ex);
+        }
+        if (locale.getLanguage().isEmpty()) throw new IllegalArgumentException("请输入有效的语言标签");
+        this.language = locale.toLanguageTag();
+        this.zone = zone.trim();
+        if (!Arrays.asList(TimeZone.getAvailableIDs()).contains(this.zone)) {
+            throw new IllegalArgumentException("请输入有效的时区名称");
+        }
+    }
+    private static AtomicFile file(Context host, int user) {
+        return new AtomicFile(new File(host.getNoBackupFilesDir(), "guest-region-" + user));
+    }
+    public static GuestRegion read(Context host, int user) throws IOException {
+        AtomicFile file = file(host, user);
+        try (DataInputStream input = new DataInputStream(file.openRead())) {
+            return new GuestRegion(input.readUTF(), input.readUTF());
+        } catch (FileNotFoundException absent) {
+            if (file.getBaseFile().exists()) throw absent;
+            return null;
+        }
+    }
+    public static void save(Context host, int user, GuestRegion region) throws IOException {
+        AtomicFile file = file(host, user);
+        if (region == null) {
+            file.delete();
+            if (file.getBaseFile().exists()) throw new IOException("无法清除来宾设置");
+            return;
+        }
+        FileOutputStream raw = file.startWrite();
+        try {
+            DataOutputStream out = new DataOutputStream(raw);
+            out.writeUTF(region.language);
+            out.writeUTF(region.zone);
+            out.flush();
+            file.finishWrite(raw);
+        } catch (IOException ex) {
+            file.failWrite(raw);
+            throw ex;
+        }
+    }
+    public static void bind(Context host, int user, Context guest) {
+        try {
+            bound = read(host, user);
+        } catch (IOException | IllegalArgumentException ex) {
+            bound = null;
+            Log.w("BlackBox", "Cannot load guest region", ex);
+        }
+        apply(guest);
+    }
+    public static void apply(Context guest) {
+        if (bound == null || guest == null) return;
+        LocaleList languages = LocaleList.forLanguageTags(bound.language);
+        Resources resources = guest.getResources();
+        Configuration config = new Configuration(resources.getConfiguration());
+        if (!languages.equals(config.getLocales())) {
+            config.setLocales(languages);
+            resources.updateConfiguration(config, resources.getDisplayMetrics());
+        }
+        LocaleList.setDefault(languages);
+        TimeZone.setDefault(TimeZone.getTimeZone(bound.zone));
+    }
+}
