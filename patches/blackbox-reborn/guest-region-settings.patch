+package top.niunaijun.blackboxa.view.main;
+
+import android.app.Activity;
+import android.app.AlertDialog;
+import android.view.Menu;
+import android.view.MenuItem;
+import android.widget.*;
+import java.io.IOException;
+import top.niunaijun.blackbox.region.GuestRegion;
+
+public final class GuestRegionDialog {
+    private static final int ID = 0x434752;
+    public static void add(Menu menu) {
+        if (menu != null) menu.add(Menu.NONE, ID, Menu.NONE, "来宾语言和时区");
+    }
+    public static boolean open(Activity host, MenuItem item, int user) {
+        if (item.getItemId() != ID) return false;
+        GuestRegion region;
+        try {
+            region = GuestRegion.read(host, user);
+        } catch (IOException | IllegalArgumentException ex) {
+            Toast.makeText(host, "读取来宾设置失败", Toast.LENGTH_LONG).show();
+            return true;
+        }
+        LinearLayout form = new LinearLayout(host);
+        form.setOrientation(LinearLayout.VERTICAL);
+        int pad = (int)(24 * host.getResources().getDisplayMetrics().density);
+        form.setPadding(pad, 0, pad, 0);
+        EditText language = field(host, form, "语言标签", "en-US", region == null ? "" : region.language);
+        EditText zone = field(host, form, "时区", "UTC", region == null ? "" : region.zone);
+        AlertDialog dialog = new AlertDialog.Builder(host).setTitle("来宾语言和时区")
+                .setMessage((region == null ? "当前跟随手机。" : "") + "设置用于当前来宾，下次冷启动应用时生效。")
+                .setView(form).setPositiveButton("保存", null).setNegativeButton("取消", null)
+                .setNeutralButton("跟随手机", null).create();
+        dialog.show();
+        dialog.getButton(-1).setOnClickListener(v -> {
+            try {
+                GuestRegion.save(host, user, new GuestRegion(language.getText().toString(), zone.getText().toString()));
+                dialog.dismiss();
+            } catch (IOException | IllegalArgumentException ex) {
+                Toast.makeText(host, "保存失败：" + ex.getMessage(), Toast.LENGTH_LONG).show();
+            }
+        });
+        dialog.getButton(-3).setOnClickListener(v -> {
+            try {
+                GuestRegion.save(host, user, null);
+                dialog.dismiss();
+            } catch (IOException ex) { Toast.makeText(host, "恢复失败", Toast.LENGTH_LONG).show(); }
+        });
+        return true;
+    }
+    private static EditText field(Activity host, LinearLayout layout, String label, String hint, String value) {
+        TextView title = new TextView(host);
+        title.setText(label);
+        layout.addView(title);
+        EditText text = new EditText(host);
+        text.setSingleLine(true);
+        text.setHint(hint);
+        text.setText(value);
+        layout.addView(text);
+        return text;
+    }
+}
