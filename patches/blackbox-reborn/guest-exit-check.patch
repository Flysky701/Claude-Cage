+package top.niunaijun.blackbox.network;
+
+import android.content.*;
+import android.os.*;
+import android.util.Log;
+
+/** A shell-owned control. The diagnostic APK and its child keep their default sockets. */
+public final class GuestExitCheck implements ServiceConnection {
+    private static final String HELPER = "io.github.leexeo.cage.localcore";
+    private final Context host;
+    private final Handler handler = new Handler(Looper.getMainLooper());
+    private boolean registered;
+
+    private GuestExitCheck(Context host) { this.host = host; }
+    public static void bind(Context host, Context guest) {
+        String pkg = guest.getPackageName();
+        if (!"io.github.leexeo.cage.plainnet".equals(pkg) && !"io.github.leexeo.cage.stablenet".equals(pkg)) return;
+        new GuestExitCheck(host).start();
+    }
+    private void start() {
+        try {
+            Intent service = new Intent().setClassName(HELPER, HELPER + ".ExitCheckService");
+            registered = host.bindService(service, this, Context.BIND_AUTO_CREATE);
+            Log.i("CageGuestExit", "bind=" + registered);
+            if (registered) handler.postDelayed(this::finish, 25000);
+        } catch (RuntimeException denied) {
+            Log.i("CageGuestExit", "bind failed " + denied.getClass().getSimpleName());
+        }
+    }
+    @Override public void onServiceConnected(ComponentName name, IBinder endpoint) {
+        Messenger remote = new Messenger(endpoint);
+        Messenger replies = new Messenger(new Handler(Looper.getMainLooper(), result -> {
+            if (result.what == 1) {
+                String ip = result.getData().getString("ipv4");
+                Log.i("CageGuestExit", "service HTTPS IPv4=" + (ip == null ? "unavailable" : ip));
+            } else if (result.what == 2) {
+                ParcelFileDescriptor receive = result.getData().getParcelable("receive");
+                ParcelFileDescriptor send = result.getData().getParcelable("send");
+                new Thread(() -> {
+                    try (ParcelFileDescriptor input = receive; ParcelFileDescriptor output = send) {
+                        if (input == null || output == null) throw new java.io.IOException("unavailable");
+                        String ip = GuestStreamHttps.fetch(new ParcelFileDescriptor.AutoCloseInputStream(input),
+                                new ParcelFileDescriptor.AutoCloseOutputStream(output));
+                        Log.i("CageGuestStream", "verified HTTPS IPv4=" + ip);
+                    } catch (Exception end) {
+                        Log.i("CageGuestStream", "stream=" + (receive == null ? "unavailable" : "failed")
+                                + " error=" + end.getClass().getSimpleName());
+                    } finally {
+                        handler.post(this::finish);
+                    }
+                }, "Cage-guest-stream-TLS").start();
+            }
+            return true;
+        }));
+        try {
+            for (int operation : new int[]{1, 2}) {
+                Message check = Message.obtain(null, operation);
+                check.replyTo = replies;
+                remote.send(check);
+            }
+        } catch (RemoteException gone) { finish(); }
+    }
+    @Override public void onServiceDisconnected(ComponentName name) { finish(); }
+    private void finish() {
+        if (!registered) return;
+        registered = false;
+        handler.removeCallbacksAndMessages(null);
+        host.unbindService(this);
+    }
+}
