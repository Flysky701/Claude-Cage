{
  "selected": "powershell",
  "connectionFile": "%USERPROFILE%\\.claude-cage\\config.json",
  "applications": {
    "powershell": {
      "program": "%SystemRoot%\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
      "arguments": [
        "-NoLogo",
        "-NoProfile",
        "-NoExit",
        "-ExecutionPolicy",
        "RemoteSigned",
        "-File",
        "{root}\\samples\\Set-SessionProxy.ps1"
      ]
    },
    "edge": {
      "program": "%ProgramFiles(x86)%\\Microsoft\\Edge\\Application\\msedge.exe",
      "browserProxy": true,
      "arguments": [
        "--user-data-dir={profile}",
        "--proxy-server={browserProxy}",
        "--proxy-bypass-list=<-loopback>",
        "--disable-quic",
        "--no-first-run",
        "--no-default-browser-check",
        "--disable-background-networking",
        "--disable-sync",
        "--new-window",
        "about:blank"
      ]
    },
    "probe": {
      "program": "samples\\DirectProbe.exe",
      "arguments": [
        "{run}",
        "{output}",
        "standard",
        "parent"
      ]
    },
    "raw-tcp": {
      "program": "samples\\RawParent.exe",
      "childPrograms": [
        "samples\\RawChild.exe"
      ],
      "tcpServices": {
        "resolver": {
          "host": "1.1.1.1",
          "port": 443
        }
      },
      "arguments": [
        "{output}\\{run}",
        "{tcpPort:resolver}"
      ]
    }
  }
}
