<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="io.github.leexeo.cage.childprobe" android:versionCode="1" android:versionName="0.1">
  <!-- target 28 permits the probe's own extracted native executable. This
       applies only to this disposable probe; GBox's target is unchanged. -->
  <uses-sdk android:minSdkVersion="28" android:targetSdkVersion="28" />
  <application android:label="Cage Child Property Probe" android:debuggable="true" android:allowBackup="false">
    <activity android:name=".ChildPropertyProbeActivity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>
  </application>
</manifest>

