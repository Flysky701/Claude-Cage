<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.leexeo.cage.webviewprobe" android:versionCode="1" android:versionName="diagnostic">
    <uses-sdk android:minSdkVersion="28" android:targetSdkVersion="35"/>
    <!-- Deliberately no uses-permission elements, including INTERNET. -->
    <application android:label="Cage WebView 诊断" android:debuggable="true"
        android:allowBackup="false" android:usesCleartextTraffic="false"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <activity android:name=".ProbeActivity$Plain" android:process=":plain" android:exported="false"/>
        <activity android:name=".ProbeActivity$Wrapped" android:process=":wrapped" android:exported="false"/>
    </application>
</manifest>
