+    private static void fixJar(ApplicationInfo info, ApplicationInfo baseApplication) {
+        try {
+            java.lang.reflect.Field field = ApplicationInfo.class.getDeclaredField("sharedLibraryInfos");
+            field.setAccessible(true);
+            Object hostLibs = baseApplication == null ? null : field.get(baseApplication);
+            if (hostLibs instanceof java.util.List && !((java.util.List<?>) hostLibs).isEmpty()) {
+                java.util.List<Object> merged = new java.util.ArrayList<>();
+                Object existing = field.get(info);
+                if (existing instanceof java.util.List) merged.addAll((java.util.List<?>) existing);
+                for (Object lib : (java.util.List<?>) hostLibs) {
+                    if (lib != null && !merged.contains(lib)) merged.add(lib);
+                }
+                field.set(info, merged);
+            }
+        } catch (Throwable ignored) {}
+
+        String APACHE_LEGACY_JAR = "/system/framework/org.apache.http.legacy.boot.jar";
+        String APACHE_LEGACY_JAR_Q = "/system/framework/org.apache.http.legacy.jar";
+        Set<String> sharedLibraryFileList = new HashSet<>();
+        if (BuildCompat.isQ()) {
