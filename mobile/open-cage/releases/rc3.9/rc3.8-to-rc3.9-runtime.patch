-    private static boolean checkUseInstalledOrHidden(int flags, BPackageUserState state,
-                                                     ApplicationInfo appInfo) {
-        if (AppSystemEnv.isBlackPackage(appInfo.packageName))
-            return false;
-        
-        if (!state.installed || state.hidden) {
-            return false;
-        }
-        return true;
