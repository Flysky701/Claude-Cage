+                   message.contains("WhatsApp") ||
+                   message.contains("Telegram") ||
+                   message.contains("Twitter") ||
+                   message.contains("TikTok") ||
+                   message.contains("Snapchat") ||
+                   message.contains("YouTube") ||
+                   message.contains("LinkedIn");
