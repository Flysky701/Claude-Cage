-            if (!FileUtils.isExist(APACHE_LEGACY_JAR_Q)) {
-                sharedLibraryFileList.add(APACHE_LEGACY_JAR);
-            } else {
-                sharedLibraryFileList.add(APACHE_LEGACY_JAR_Q);
-            }
-        } else {
-            sharedLibraryFileList.add(APACHE_LEGACY_JAR);
-        }
-
-
-
-
-
-        info.sharedLibraryFiles = sharedLibraryFileList.toArray(new String[]{});
